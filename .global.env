# Environment file to define constants (vars, alias, etc.)
# WARN: Never put secrets here
#
################################################################################
# XDG Config
################################################################################
export XDG_CONFIG_HOME=$HOME/.config


################################################################################
# History
################################################################################
HISTSIZE=1000000000
SAVEHIST=$HISTSIZE
HISTDUP=erase
# setopt INC_APPEND_HISTORY
setopt hist_ignore_all_dups
setopt hist_save_no_dups
setopt hist_ignore_dups
setopt hist_find_no_dups
setopt appendhistory
setopt sharehistory
setopt hist_ignore_space



################################################################################
# Editor
################################################################################

# Prefer nvim if installed
if command -v nvim &> /dev/null; then
  alias vi='nvim'
  alias vim='nvim'
fi

export EDITOR='vim'
export VISUAL='vim'
bindkey -e 'emacs'

################################################################################
# Browser
################################################################################
if [[ -n "$WSL_DISTRO_NAME" ]]; then
  if command -v wslview >/dev/null 2>&1; then
    export BROWSER=wslview
    export GH_BROWSER=wslview
  else
    print -u2 -- "Warning: WSL detected, but 'wslview' is not installed; BROWSER is unchanged."
  fi
fi


################################################################################
# File system navigation
################################################################################
alias ls='ls --color'
alias ll='ls -l'
alias la='ls -A'
alias l='ls -CF'

alias cd="cd -P"

alias less='less -R'


################################################################################
# Functions
################################################################################
activate() {
    if [ $# -eq 0 ]
      then
        source .venv/bin/activate
      else
        source ${1%/}/.venv/bin/activate
    fi
}

alias bat="bat -S"
